# Alpaca PAPER Trading
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Anthropic
ANTHROPIC_API_KEY=

# FRED
FRED_API_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SEC EDGAR
SEC_USER_AGENT=stockpilot adrian@example.com

# Risk Management
MAX_POSITION_PCT=0.03
MAX_SECTOR_PCT=0.40
MAX_PORTFOLIO_INVESTED=0.80
MAX_POSITIONS=15
DAILY_DRAWDOWN_LIMIT=0.02
WEEKLY_DRAWDOWN_LIMIT=0.05
MIN_POSITION_USD=100

# Strategies
SCAN_INTERVAL_SECONDS=900
MIN_SIGNAL_SCORE=0.65

# Screener (IEX-feed volume is ~2-3% of consolidated; 200k IEX ≈ ~8-10M real)
SCREENER_MIN_VOLUME=200000
SCREENER_MIN_PRICE=5

# Exit: continuous ATR trailing (ATR(14) daily). 2.5 = backtest winner.
ATR_TRAILING_FACTOR=2.5
ATR_INITIAL_STOP_FACTOR=2.0
MAX_CLAUDE_CALLS_PER_SCAN=12
MOMENTUM_WEIGHT=0.30
MEAN_REVERSION_WEIGHT=0.25
WHALE_FOLLOW_WEIGHT=0.25
CLAUDE_WEIGHT=0.20

# Watchlist (additional to S&P 500)
EXTRA_WATCHLIST=NVDA,AAPL,MSFT,GOOGL,AMZN,META,TSLA,AMD,PLTR,COIN
